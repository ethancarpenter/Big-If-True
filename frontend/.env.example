NEXT_PUBLIC_API_URL=http://localhost:5080

# PUBLIC BY DESIGN, not secrets - a single shared recruiter demo account
# whose data resets on every login (see DemoDataSeeder.ResetAsync on the
# backend), so publishing its credentials is intentional and safe. Only set
# these once a production demo account actually exists (see DemoSeed:* on
# the backend); leave both unset locally otherwise.
NEXT_PUBLIC_DEMO_EMAIL=demo@ethancarpenter.dev
NEXT_PUBLIC_DEMO_PASSWORD=<the demo account's public password>
